# Your BGG API token from https://boardgamegeek.com/applications
# Copy this file to .env for local development
BGG_TOKEN=your-bgg-token-here

# Supabase — shared collection and Event Planner database
# Get these from your Supabase project: Settings → API
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only credentials for the local/Vercel admin collection endpoint
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
ADMIN_PASSWORD=your-admin-password-here
